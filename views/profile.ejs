<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Cuenta - Auth App</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="dashboard">
        <div class="dashboard-header">
            <h1>Mi Cuenta</h1>
            <div class="user-info">
                <div class="user-avatar" id="userAvatar">U</div>
                <div>
                    <div id="userName">Cargando...</div>
                    <div style="font-size: 0.8rem; color: var(--text-light);">Perfil</div>
                </div>
            </div>
        </div>

        <nav class="nav-menu">
            <ul>
                <li><a href="/user-dashboard">Inicio</a></li>
                <li><a href="/admin-dashboard" onclick="goToAdmin(event)">Admin</a></li>
                <li><a href="/profile" class="active">Mi Cuenta</a></li>
                <li><a href="#" onclick="logout()">Cerrar Sesión</a></li>
            </ul>
        </nav>

        <div class="welcome-section">
            <h2>Información Personal</h2>
            <p>Actualiza tus datos personales aquí</p>
        </div>

        <form id="profileForm" class="profile-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="name">Nombre</label>
                    <input type="text" id="name" name="name" required>
                    <div class="error" id="nameError"></div>
                </div>

                <div class="form-group">
                    <label for="lastName">Apellido</label>
                    <input type="text" id="lastName" name="lastName" required>
                    <div class="error" id="lastNameError"></div>
                </div>
            </div>

            <div class="form-group">
                <label for="phoneNumber">Teléfono</label>
                <input type="tel" id="phoneNumber" name="phoneNumber" inputmode="numeric" maxlength="9" pattern="[0-9]{9}" required>
                <div class="error" id="phoneError"></div>
            </div>

            <div class="form-group">
                <label for="birthdate">Fecha de Nacimiento</label>
                <input type="date" id="birthdate" name="birthdate" required>
                <div class="error" id="birthdateError"></div>
            </div>

            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input type="email" id="email" name="email" required>
                <div class="error" id="emailError"></div>
            </div>

            <div class="form-group">
                <label for="currentPassword">Contraseña Actual</label>
                <input type="password" id="currentPassword" name="currentPassword" placeholder="Dejar en blanco para no cambiar">
                <div class="error" id="currentPasswordError"></div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="newPassword">Nueva Contraseña</label>
                    <input
                        type="password"
                        id="newPassword"
                        name="newPassword"
                        minlength="8"
                        autocomplete="new-password"
                        placeholder="Opcional"
                        title="Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo"
                    >
                    <small class="field-help">Mínimo 8 caracteres, mayúscula, minúscula, número y símbolo.</small>
                    <div class="error" id="newPasswordError"></div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirmar Nueva Contraseña</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Opcional">
                    <div class="error" id="confirmPasswordError"></div>
                </div>
            </div>

            <div class="btn-group">
                <button type="submit" class="btn">Guardar Cambios</button>
                <button type="button" class="btn btn-secondary" onclick="cancelEdit()">Cancelar</button>
            </div>

            <div class="error" id="generalError"></div>
            <div class="success" id="successMessage"></div>
        </form>
    </div>

    <script src="/utils.js"></script>
    <script src="/profile.js"></script>
</body>
</html>
