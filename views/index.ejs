<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auth App - Sistema de Autenticación</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <div class="logo">
            <h1>Auth App</h1>
            <p>Sistema de Autenticación Seguro</p>
        </div>

        <div style="text-align: center; margin: 2rem 0;">
            <h2 style="color: var(--primary-color); margin-bottom: 1rem;">Bienvenido</h2>
            <p style="color: var(--text-light); margin-bottom: 2rem;">
                Elige una opción para comenzar
            </p>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <a href="/signin" class="btn">Iniciar Sesión</a>
                <a href="/signup" class="btn btn-secondary">Registrarse</a>
            </div>
        </div>
    </div>
</body>
</html>
