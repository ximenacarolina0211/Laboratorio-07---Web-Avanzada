<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrarse - Auth App</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <div class="logo">
            <h1>Auth App</h1>
            <p>Crea tu cuenta</p>
        </div>

        <form id="signupForm">
            <div class="form-group">
                <label for="name">Nombre</label>
                <input type="text" id="name" name="name" required>
                <div class="error" id="nameError"></div>
            </div>

            <div class="form-group">
                <label for="lastName">Apellido</label>
                <input type="text" id="lastName" name="lastName" required>
                <div class="error" id="lastNameError"></div>
            </div>

            <div class="form-group">
                <label for="phoneNumber">Teléfono</label>
                <input
                    type="tel"
                    id="phoneNumber"
                    name="phoneNumber"
                    inputmode="numeric"
                    maxlength="9"
                    pattern="[0-9]{9}"
                    required
                >
                <div class="error" id="phoneError"></div>
            </div>

            <div class="form-group">
                <label for="birthdate">Fecha de Nacimiento</label>
                <input type="date" id="birthdate" name="birthdate" required>
                <div class="error" id="birthdateError"></div>
            </div>

            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input type="email" id="email" name="email" required>
                <div class="error" id="emailError"></div>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    minlength="8"
                    autocomplete="new-password"
                    title="Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo"
                    required
                >
                <small class="field-help">Mínimo 8 caracteres, mayúscula, minúscula, número y símbolo.</small>
                <div class="error" id="passwordError"></div>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirmar Contraseña</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required>
                <div class="error" id="confirmPasswordError"></div>
            </div>

            <button type="submit" class="btn">Registrarse</button>
            <div class="error" id="generalError"></div>
            <div class="success" id="successMessage"></div>
        </form>

        <div class="link">
            ¿Ya tienes cuenta? <a href="/signin">Inicia Sesión</a>
        </div>
    </div>

    <script src="/signup.js"></script>
</body>
</html>
